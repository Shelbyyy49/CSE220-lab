public static void sumOddAppend(Node dh) {
      int sum = 0;
      Node current = dh.next;
      Node build = dh;
      while(current!=dh){
        if((Integer)current.elem%2==1){
          sum+=(Integer)current.elem;
          build.next = current.next;
          current = current.next;
        }
        else{
          build = current;
          current = current.next;
        }
      }
      Node newNode = new Node(sum);
      build.next = newNode;
      newNode.next = dh;    
    }

