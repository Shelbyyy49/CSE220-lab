public class LabTask1 {
    public static Boolean assembleCongaLine(Node head){ 
      if(head==null || head.next==null){
        return true;
      }
      Node cur = head;
      while(cur.next!=null){
        Integer val1 = (Integer)cur.elem;
        Integer val2 = (Integer)cur.next.elem;
        if(val1>val2){
          return false;
        }
        cur = cur.next;
      }
      return true;
    }

