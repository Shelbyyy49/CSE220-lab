public class LabTask2 {
    public static Node wordDecoder( Node head ){
        Node current = head;
        int count = 0;
        while(current!=null){
          count++;
          current = current.next;
        }
        int l = 13%count;
        int idx = 0;
        Node prev = null;
        current = head;
        Node dumdum = new Node(null);
        while(current!=null){
          if(idx%l==0 && idx!=0){
            Node newNode = new Node(current.elem);
            newNode.next = prev;
            prev = newNode;
          }
          idx++;
          current = current.next;
        }
        dumdum.next = prev;
        return dumdum;
    }

