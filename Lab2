public class AssignmentTask1 {
    public static String checkSimilar( Node building1, Node building2 ){
      Node cur1 = building1;
      Node cur2 = building2;
      while(cur1!=null && cur2!=null){
        if(cur1.elem!=cur2.elem){
          return "Not Similar";
        }
        cur1 = cur1.next;
        cur2 = cur2.next;
      }
      if(cur1==null && cur2==null){
        return "Similar";
      }
      else{
        return "Not Similar";
      }
    }

