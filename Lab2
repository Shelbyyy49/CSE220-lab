public static Node alternateMerge( Node head1, Node head2 ){
      Node t1 = head1;
      Node t2 = head2;
      while(t1!=null && t2!=null){
        Node front1 = t1.next;
        t1.next = t2;
        Node front2 = t2.next;
        t2.next = front1;
        t1 = front1;
        t2 = front2;
      }
      return head1;
    }

