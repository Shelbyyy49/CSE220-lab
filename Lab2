public static Node idGenerator(Node head1, Node head2, Node head3) {
      Node cur1 = head1;
      Node prev = null;
      while(cur1!=null){
        Node front = cur1.next;
        cur1.next = prev;
        prev = cur1;
        cur1 = front;
      }
      Node dumdum = new Node(null);
      Node temp = dumdum;
      Node cur2 = head2;
      Node cur3 = head3;
      while(cur2!=null && cur3!=null){
        Node newNode = new Node(((Integer)cur2.elem+(Integer)cur3.elem)%10);
        temp.next = newNode;
        temp = newNode;
        cur2 = cur2.next;
        cur3 = cur3.next;
      }
      Node current = prev;
      while(current.next!=null){
        current = current.next;
      }
      current.next = dumdum.next;
      return prev;
    }

