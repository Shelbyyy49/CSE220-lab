public static void pairJoin(DNode dh1, DNode dh2) {
        DNode cur1 = dh1.next;
        DNode cur2 = dh2.next;
        DNode last = dh1;
        while(cur1!=null){
          DNode temp1 = cur1.next;
          DNode temp2 = cur2.next;
          cur1.next = cur2;
          cur2.prev = cur1;
          cur2.next = temp1;
          if(temp1!=null){
            temp1.prev = cur2;
          }
          last = cur2;
          cur1 = temp1;
          cur2 = temp2;
        }
        last.next = dh1;
        dh1.prev = last;
    }

//assignment task7
public static void rangeMove(DNode dh, int start, int end) {
        int count = 0;
        DNode current = dh.next;
        while(current!=dh){
          count++;
          current = current.next;
        }
        current = dh.next;
        for(int i=0; i<count; i++){
          DNode temp = current.next;
          if((Integer)current.elem>=start && (Integer)current.elem<=end){
            current.prev.next = current.next;
            current.next.prev = current.prev;
            DNode tail = dh.prev;
            tail.next = current;
            current.prev = tail;
            current.next = dh;
            dh.prev = current;
          }
          current = temp;
        }
    }
