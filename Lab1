import java.util.*;
public class LabTask1{
  public static void main(String []args){
    Scanner sc = new Scanner(System.in);
    int row = sc.nextInt();
    int col = sc.nextInt();
    int[][]arr = new int[row][col];
    for(int i=0; i<row; i++){
      for(int j=0; j<col; j++){
        arr[i][j] = sc.nextInt();
      }
    }
    if(row%2!=0){
      for(int i=0; i<col; i++){
        if(i%2==0){
          for(int j=0; j<row; j=j+2){
            System.out.print(arr[j][i]+" ");
          }
        }
        else{
          for(int j=row-2; j>0; j=j-2){
            System.out.print(arr[j][i]+" ");
          }
        }
        System.out.println();
      }
    }
    else{
      for(int i=0; i<col; i++){
        if(i%2==0){
          for(int j=0; j<row; j=j+2){
            System.out.print(arr[j][i]+" ");
          }
        }
        else{
          for(int j=row-2; j>0; j=j-2){
            System.out.print(arr[j][i]+" ");
          }
        }
        System.out.println();
      }
    }
  }
}
          
        
