public static void playGame(Integer[][] arena){
      int row = arena.length;
      int col = arena[0].length;
      int pts = 0;
      for(int i=0; i<row; i++){
        for(int j=0; j<col; j++){
          if(arena[i][j]!=0 && arena[i][j]%50==0){
            if(i>0 && arena[i-1][j]==2){
              pts+=2;
            }
            if(i<row-1 && arena[i+1][j]==2){
              pts+=2;
            }
            if(j>0 && arena[i][j-1]==2){
              pts+=2;
            }
            if(j<col-1 && arena[i][j+1]==2){
              pts+=2;
            }
          }
        }
      }
      if(pts>=10){
        System.out.println("Points gained: "+pts+". Your team has survived the game.");
      }
      else{
        System.out.println("Points gained: "+pts+". Your team is out.");
      }
    }
}

